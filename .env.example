# Copy to .env next to docker-compose.yml. Every value has a dev default.

# Public origin short links are served from (the nginx container in compose).
BASE_URL=http://localhost:8080

# Use a long random value in production: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-secret-change-me-in-production

# Optional: MaxMind GeoLite2-Country.mmdb path inside the container, for country lookup
# when no CDN country header (CF-IPCountry etc.) is present.
GEOIP_DB_PATH=

# Host ports for local Postgres/Redis (chosen to avoid clashing with other projects).
POSTGRES_PORT=55432
REDIS_PORT=56379
